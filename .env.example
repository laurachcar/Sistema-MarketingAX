# Copie para .env e preencha. Nunca faça commit do .env.

# API do Claude
ANTHROPIC_API_KEY=

# Modelos (decisão da arquitetura v1: barato por padrão, forte só no Estrategista e no Avaliador)
AX_MODELO_PADRAO=claude-haiku-5-5
AX_MODELO_FORTE=claude-sonnet-5-5

# Supabase
SUPABASE_URL=
# Chave anon: usada pelos agentes, sempre com JWT escopado por tenant e cliente (RLS)
SUPABASE_ANON_KEY=
# Chave service role: só para migrações e para o onboarding de conta. Nunca entregar a um agente.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Teto de tokens por cliente por mês (alerta, não corte)
AX_TETO_TOKENS_CLIENTE_MES=2000000
